@model LoginForm
@{ ViewData["Title"] = "Giriş"; }
<h1>Giriş</h1>
<form method="post" class="col-md-6">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Email" class="form-label">E-posta</label><input asp-for="Email" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">Şifre</label><input asp-for="Password" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Beni hatırla</label></div>
    <button class="btn btn-primary">Giriş yap</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
