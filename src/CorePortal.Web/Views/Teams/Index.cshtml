@model IReadOnlyList<Team>
@{ ViewData["Title"] = "Ar-Ge Takımları"; }
<h1>Ar-Ge Takımları</h1>
<form method="get" class="row g-2 mb-4 align-items-end" role="search">
    <div class="col-md-5"><label for="q" class="form-label">Takımlarda ara</label><input id="q" name="q" value="@ViewBag.Query" maxlength="200" class="form-control" placeholder="Ad veya açıklama" /></div>
    <div class="col-md-4"><label for="field" class="form-label">Çalışma alanı</label><select id="field" name="field" class="form-select"><option value="">Tüm alanlar</option>@foreach (string field in ViewBag.Fields) { <option value="@field" selected="@(ViewBag.Field == field)">@field</option> }</select></div>
    <div class="col-md-auto"><button class="btn btn-primary">Filtrele</button> <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a></div>
</form>
<div class="row g-3">
@foreach (var team in Model) {
    <div class="col-md-6"><div class="card h-100"><div class="card-body">
        <h2 class="h5 card-title">@team.Name</h2><p class="text-muted">@team.Field · @team.FoundedYear</p>
        <p>@team.Description</p><a asp-action="Details" asp-route-id="@team.Id" class="btn btn-outline-primary">Detay</a>
    </div></div></div>
}
</div>
@if (Model.Count == 0) { <p class="empty-state">Bu filtrelerde takım bulunamadı.</p> }
