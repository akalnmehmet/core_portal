@model IReadOnlyList<Event>
@{ ViewData["Title"] = "Etkinlikler"; }
<h1>Etkinlikler</h1>
@foreach (var item in Model) {
    <div class="card mb-3"><div class="card-body">
        <h2 class="h5">@item.Title</h2><p>@item.StartsAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @item.Location</p>
        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Detay ve başvuru</a>
    </div></div>
}
@if (Model.Count == 0) { <p>Henüz etkinlik eklenmedi.</p> }
