@model Event
@{ ViewData["Title"] = Model.Title; var occupied = Model.Registrations.Count(x => x.Status != ApplicationStatus.Rejected); }
<h1>@Model.Title</h1>
<p class="text-muted">@Model.StartsAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.Location</p>
<p>@Model.Description</p><p>Kontenjan: @occupied / @Model.Capacity</p>
@if (Model.StartsAt > DateTime.UtcNow && occupied < Model.Capacity) {
    <form asp-action="Register" asp-route-id="@Model.Id" method="post"><button class="btn btn-primary">Etkinliğe başvur</button></form>
} else { <p class="text-muted">Başvuru kapalı.</p> }
