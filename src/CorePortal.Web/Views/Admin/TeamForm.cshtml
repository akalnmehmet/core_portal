@model TeamForm
@{ var edit = ViewBag.Id != null; ViewData["Title"] = edit ? "Takımı düzenle" : "Yeni takım"; }
<h1>@ViewData["Title"]</h1>
<form method="post" class="col-md-8">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label">Takım adı</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Field" class="form-label">Çalışma alanı</label><input asp-for="Field" class="form-control" /></div>
    <div class="mb-3"><label asp-for="FoundedYear" class="form-label">Kuruluş yılı</label><input asp-for="FoundedYear" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Description" class="form-label">Tanıtım</label><textarea asp-for="Description" class="form-control" rows="5"></textarea></div>
    <button class="btn btn-primary">Kaydet</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
