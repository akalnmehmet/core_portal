@model IReadOnlyList<Event>
@{ ViewData["Title"] = "Etkinlik yönetimi"; }
<h1>Etkinlik yönetimi</h1>
<div class="d-flex flex-wrap gap-2 mb-3"><a asp-action="CreateEvent" class="btn btn-primary">Yeni etkinlik</a><a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Yönetim paneli</a></div>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Etkinlik</th><th>Tarih</th><th>Kontenjan</th><th>İşlemler</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.Title</td><td>@item.StartsAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td><td>@item.Registrations.Count(x => x.Status != ApplicationStatus.Rejected) / @item.Capacity</td><td class="action-cell">
<a asp-action="EditEvent" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
<form asp-action="DeleteEvent" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Etkinlik ve tüm başvuruları silinsin mi?')"><button class="btn btn-sm btn-outline-danger">Sil</button></form>
</td></tr>
}
</tbody></table></div>
@if (Model.Count == 0) { <p class="empty-state">Henüz etkinlik eklenmedi.</p> }
