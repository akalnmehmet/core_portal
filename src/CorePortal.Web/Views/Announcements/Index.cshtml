@model IReadOnlyList<Announcement>
@{ ViewData["Title"] = "Duyurular"; }
<h1>Duyurular</h1>
<form method="get" class="row g-2 mb-4 align-items-end" role="search">
<div class="col-md-8"><label for="q" class="form-label">Duyurularda ara</label><input id="q" name="q" value="@ViewBag.Query" maxlength="200" class="form-control" placeholder="Başlık veya içerik" /></div>
<div class="col-md-auto"><button class="btn btn-primary">Ara</button> <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a></div>
</form>
@foreach (var item in Model) {
<article class="card card-body mb-3">
<h2 class="h5"><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h2>
<p class="text-muted">@item.PublishedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @(item.Author.FullName ?? "CORE Yönetimi")</p>
<p class="text-preview mb-0">@(item.Content.Length > 260 ? item.Content[..260] + "…" : item.Content)</p>
</article>
}
@if (Model.Count == 0) { <p class="empty-state">Gösterilecek duyuru bulunamadı.</p> }
